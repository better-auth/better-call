{
	"name": "better-call",
	"version": "2.0.5",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/better-auth/better-call.git",
		"directory": "packages/experimental"
	},
	"copyright": "Copyright (C) 2025 Bereket Engida",
	"license": "MIT",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"lint:package": "publint --strict .",
		"lint:type": "attw --profile node16 --pack .",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"coverage:open": "open coverage/index.html",
		"build": "tsdown",
		"dev": "tsdown --watch"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.1.21"
	},
	"exports": {
		".": {
			"dev-source": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./error": {
			"dev-source": "./src/error.ts",
			"import": {
				"types": "./dist/error.d.mts",
				"default": "./dist/error.mjs"
			},
			"require": {
				"types": "./dist/error.d.cts",
				"default": "./dist/error.cjs"
			}
		},
		"./schema": {
			"dev-source": "./src/schema.ts",
			"import": {
				"types": "./dist/schema.d.mts",
				"default": "./dist/schema.mjs"
			},
			"require": {
				"types": "./dist/schema.d.cts",
				"default": "./dist/schema.cjs"
			}
		},
		"./plugins/http": {
			"dev-source": "./src/plugins/http/index.ts",
			"import": {
				"types": "./dist/plugins/http.d.mts",
				"default": "./dist/plugins/http.mjs"
			},
			"require": {
				"types": "./dist/plugins/http.d.cts",
				"default": "./dist/plugins/http.cjs"
			}
		},
		"./plugins/http/client": {
			"dev-source": "./src/plugins/http/client/index.ts",
			"import": {
				"types": "./dist/plugins/http/client/index.d.mts",
				"default": "./dist/plugins/http/client/index.mjs"
			},
			"require": {
				"types": "./dist/plugins/http/client/index.d.cts",
