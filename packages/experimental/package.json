		},
		"./plugins/http/react": {
			"dev-source": "./src/plugins/http/client/react.ts",
			"import": {
				"types": "./dist/plugins/http/client/react.d.mts",
				"default": "./dist/plugins/http/client/react.mjs"
			},
			"require": {
				"types": "./dist/plugins/http/client/react.d.cts",
				"default": "./dist/plugins/http/client/react.cjs"
			}
		},
		"./plugins/read-only": {
			"dev-source": "./src/plugins/read-only.ts",
