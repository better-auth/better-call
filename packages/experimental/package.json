{
	"name": "better-call",
	"version": "2.0.5",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/better-auth/better-call.git",
		"directory": "packages/experimental"
	},
	"copyright": "Copyright (C) 2025 Bereket Engida",
	"license": "MIT",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"lint:package": "publint --strict .",
		"lint:type": "attw --profile node16 --pack .",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"coverage:open": "open coverage/index.html",
		"build": "tsdown",
		"dev": "tsdown --watch"
	},
	"devDependencies": {
		"@better-auth/core": "1.6.28",
		"@libsql/client": "^0.17.4",
		"@types/body-parser": "^1.19.6",
		"@types/express": "^5.0.3",
		"@types/set-cookie-parser": "^2.4.10",
		"@types/supertest": "^7.2.0",
		"body-parser": "^2.2.0",
		"drizzle-orm": "^0.45.2",
		"express": "^5.1.0",
		"supertest": "^7.1.4"
	},
	"dependencies": {
		"@better-auth/utils": "^0.4.2",
		"@better-fetch/fetch": "^1.3.1",
		"rou3": "^0.7.12",
		"set-cookie-parser": "^3.0.1"
	},
	"peerDependencies": {
		"drizzle-orm": "^0.45.2",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"dev-source": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./error": {
			"dev-source": "./src/error.ts",
			"import": {
				"types": "./dist/error.d.mts",
				"default": "./dist/error.mjs"
			},
			"require": {
				"types": "./dist/error.d.cts",
				"default": "./dist/error.cjs"
			}
		},
		"./adapter": {
			"dev-source": "./adapter/mod.ts",
			"import": {
				"types": "./dist/adapter.d.mts",
				"default": "./dist/adapter.mjs"
			},
			"require": {
				"types": "./dist/adapter.d.cts",
				"default": "./dist/adapter.cjs"
			}
		},
		"./adapter/drizzle": {
			"dev-source": "./adapter/drizzle/index.ts",
			"import": {
				"types": "./dist/drizzle.d.mts",
				"default": "./dist/drizzle.mjs"
			},
			"require": {
				"types": "./dist/drizzle.d.cts",
				"default": "./dist/drizzle.cjs"
			}
		}
	},
	"files": [
		"dist"
	]
}
