{
	"name": "better-call",
	"version": "1.3.7",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/better-auth/better-call.git",
		"directory": "packages/better-call"
	},
	"copyright": "Copyright (C) 2025 Bereket Engida",
	"license": "MIT",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"lint:package": "publint --strict .",
		"lint:type": "attw --profile node16 --pack .",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"coverage:open": "open coverage/index.html",
		"build": "tsdown",
		"dev": "tsdown --watch"
	},
	"devDependencies": {
		"@types/body-parser": "^1.19.6",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.1",
		"body-parser": "^2.3.0",
		"express": "^5.2.1",
		"supertest": "^7.2.2"
	},
	"dependencies": {
		"@better-auth/utils": "^0.5.0",
		"@better-fetch/fetch": "^1.3.1",
		"rou3": "^0.9.1",
		"set-cookie-parser": "^3.1.2"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"dev-source": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./client": {
			"dev-source": "./src/client.ts",
			"import": {
				"types": "./dist/client.d.mts",
				"default": "./dist/client.mjs"
			},
			"require": {
				"types": "./dist/client.d.cts",
				"default": "./dist/client.cjs"
			}
		},
		"./error": {
			"dev-source": "./src/error.ts",
			"import": {
				"types": "./dist/error.d.mts",
				"default": "./dist/error.mjs"
			},
			"require": {
				"types": "./dist/error.d.cts",
				"default": "./dist/error.cjs"
			}
		},
		"./node": {
			"dev-source": "./src/node.ts",
			"import": {
				"types": "./dist/node.d.mts",
				"default": "./dist/node.mjs"
			},
			"require": {
				"types": "./dist/node.d.cts",
				"default": "./dist/node.cjs"
			}
		}
	},
	"files": [
		"dist"
	]
}
