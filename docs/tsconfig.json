{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"composite": false,
		"declaration": false,
		"emitDeclarationOnly": false,
		"incremental": true,
		"jsx": "preserve",
		"lib": ["dom", "dom.iterable", "esnext"],
		"noEmit": true,
		"plugins": [{ "name": "next" }]
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		".source/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx"
	],
	"exclude": ["node_modules"]
}
