{
	"$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
	"useGitignore": true,
	"words": [
		// misspelled
		"clazz",
		// misspelled, but it IS the exported type name (FnDefination)
		"Defination",
		// a deliberate typo example in a doc comment ("c.tpyo does not")
		"tpyo",

		// third party libraries
		"attw",
		"bumpp",
		"arktype",

		// auth words
		"scim",
		"OpenAPIHTML",
		"Keypair",
		"keypair",

		// experimental package vocabulary
		"Customizer",
		"dedup",
		"dedups",
		"deriveds",
		"omittable",
		"renamer",
		"uncallable",
		"unflushed",
		"uninterceptable",
		"unqueryable",
		"unvalidated",
		"travelling",
		// test fixture variable names (wuser, xuser, puser)
		"wuser",
		"xuser",
		"puser",
		"licence",
		"sess",
		"chal",
		"notx",
		"httpt",
		"Expt",

		// proper names
		"Bereket",
		"Engida",
		"Bekacru"
	],
	"ignorePaths": [
		"patches",
		"pnpm-workspace.yaml",
		"pnpm-lock.yaml",
		"e2e/smoke/test/fixtures/cloudflare/worker-configuration.d.ts",
		"*.config.js",
		"*.config.ts",
		"*.json"
	]
}
